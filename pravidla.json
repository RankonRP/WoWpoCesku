  "regexy": [
    {
      "popis": "neviditelné znaky nulové šířky z Google (ve hře se zobrazí jako ��)",
      "hledat": "[\\u200B\\u200C\\u200D\\u2060\\uFEFF]",
      "nahradit": ""
    },
    {
      "popis": "rozkaz -ujte -> -uj (bojujte, pracujte)",
      "hledat": "(?<!\\p{L})(\\p{L}+)ujte(?!\\p{L})",
      "nahradit": "$1uj"
    },
    {
      "popis": "rozkaz -ejte/-ějte -> -ej/-ěj (hledejte, podívejte, mějte)",
      "hledat": "(?<!\\p{L})(\\p{L}+)(e|ě)jte(?!\\p{L})",
      "nahradit": "$1$2j"
    },
    {
      "popis": "rozkaz -ijte -> -ij (použijte, pijte)",
      "hledat": "(?<!\\p{L})(\\p{L}+)ijte(?!\\p{L})",
      "nahradit": "$1ij"
    },
    {
      "popis": "rozkaz -ěte -> -i (zjistěte, sedněte, vyčistěte)",
      "hledat": "(?<!\\p{L})(\\p{L}+)ěte(?!\\p{L})",
      "nahradit": "$1i"
    },
    {
      "popis": "rozkaz -ťte/-ďte/-ňte/-žte -> bez -te (vraťte, posaďte, chraňte, ukažte); -čte jen ze seznamu (jinak by z 'přečte' vzniklo 'přeč')",
      "hledat": "(?<!\\p{L})(\\p{L}+[ťďňž])te(?!\\p{L})",
      "nahradit": "$1"
    },
    {
      "popis": "minulý čas u tykání: 'našli jsi' -> 'našel jsi' (-šli -> -šel)",
      "hledat": "(?<!\\p{L})(\\p{L}*)šli(\\s+(?:jsi|bys))(?!\\p{L})",
      "nahradit": "$1šel$2"
    },
    {
      "popis": "minulý čas u tykání: 'udělali jsi' -> 'udělal jsi'",
      "hledat": "(?<!\\p{L})(?!(?:[Jj]estli|[Zz]dali|[Kk]dyžli|[Aa]ni)(?!\\p{L}))(\\p{L}+)li(\\s+(?:jsi|bys))(?!\\p{L})",
      "nahradit": "$1l$2"
    },
    {
      "popis": "minulý čas u tykání: 'jsi přišli' / 'abys mi přišli' -> '…přišel'",
      "hledat": "(?<!\\p{L})((?:a)?bys|jsi)(\\s+(?:\\p{L}+\\s+){0,2}?)(\\p{L}*)šli(?!\\p{L})",
      "nahradit": "$1$2$3šel"
    },
    {
      "popis": "minulý čas u tykání: 'jsi byli' / 'bys mi mohli' -> '…byl/mohl'",
      "hledat": "(?<!\\p{L})((?:a)?bys|jsi)(\\s+(?:\\p{L}+\\s+){0,2}?)(?!(?:[Jj]estli|[Zz]dali|[Kk]dyžli|[Aa]ni)(?!\\p{L}))(\\p{L}+)li(?!\\p{L})",
      "nahradit": "$1$2$3l"
    },
    {
      "popis": "vykání v přítomném čase: -íte -> -íš (myslíte, vidíte, umíte)",
      "hledat": "(?<!\\p{L})(\\p{L}+)íte(?!\\p{L})",
      "nahradit": "$1íš"
    },
    {
      "popis": "vykání v přítomném čase: -áte -> -áš (děláte, znáte, hledáte)",
      "hledat": "(?<!\\p{L})(\\p{L}+)áte(?!\\p{L})",
      "nahradit": "$1áš"
    },
    {
      "popis": "mezery uvnitř značek",
      "hledat": "\\{\\s*([NCR])\\s*\\}",
      "nahradit": "{$1}"
    }
  ]
